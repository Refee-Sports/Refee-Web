# Refee Web — environment
#
# These MUST point at the same Supabase project as the mobile app
# (refee-mobile/refee/.env.dev). One project = one set of user accounts, so a
# referee who signs up on the web can sign in on the app and vice versa.
#
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — same publishable key as the app's EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY.
# Used by Stripe Elements for "pay crew" and saving a card for auto-pay.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# development | staging | production
NEXT_PUBLIC_APP_ENV=development
